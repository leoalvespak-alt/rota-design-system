#!/usr/bin/env bash
# Pre-commit hook: reject files with control characters that indicate
# PowerShell interpolation corruption (\x00-\x08, \x0B, \x0C, \x0E-\x1F).

set -euo pipefail

dirty_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$dirty_files" ]; then
  exit 0
fi

failed=0
for file in $dirty_files; do
  # Skip binary files and this hook itself
  if file --mime-encoding "$file" 2>/dev/null | grep -q binary; then
    continue
  fi
  if [ "$file" = ".githooks/pre-commit" ]; then
    continue
  fi
  if grep -qP '[\x00-\x08\x0B\x0C\x0E-\x1F]' "$file" 2>/dev/null; then
    echo "REJECTED: $file contains control characters (PowerShell interpolation corruption?)"
    echo "  Fix: rewrite the file without using PowerShell interpolated here-strings (@\"...\"@)"
    echo "  or Set-Content with \$ interpolation. Use @'...'@, bash heredocs, or agent tools."
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo ""
  echo "Commit blocked. Remove control characters before committing."
  exit 1
fi
